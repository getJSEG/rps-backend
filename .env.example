NODE_ENV=development
PORT=8080

# Primary DB connection used by src/config/database.js
DATABASE_URL=postgresql://user:password@localhost:5432/rps-backend

# Fallback DB settings (used only if DATABASE_URL is removed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rps-backend
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRE=7d

# --- Guest order tracking links ---
# Guest orders are opened with /guest-orders/:id?token=..., so these secrets are what make
# those links valid. Changing either one invalidates every existing guest tracking link.
# GUEST_TRACKING_TOKEN_PEPPER salts the stored token hash (falls back to JWT_SECRET).
GUEST_TRACKING_TOKEN_PEPPER=
# GUEST_TRACKING_TOKEN_SECRET encrypts the stored token so shipped/refund/cancel emails can
# rebuild the link (falls back to GUEST_TRACKING_TOKEN_PEPPER, then JWT_SECRET).
GUEST_TRACKING_TOKEN_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# false = checkout completes without PaymentIntent (bypass). true = use Stripe when STRIPE_SECRET_KEY is set.
STRIPE_PAYMENT_ENABLED=false

# --- Email / transactional mail (Resend) ---
# Server-side only. Never expose this key to the React frontend.
RESEND_API_KEY=
# Sender must belong to a domain verified in the SAME Resend account as the key above.
# With no verified domain, use "RPS Store <onboarding@resend.dev>", which can only deliver
# to that Resend account's own owner address.
EMAIL_FROM="RPS Store <orders@pearlstacks.com>"
# true = never mail the customer. With EMAIL_TEST_RECIPIENT set, every message is really
# delivered to that address with a [DEV] subject; with it blank, messages are only logged.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
# Used to build customer-facing links in emails (password reset, etc.).
# FRONTEND_URL wins; APP_BASE_URL is the fallback. In local dev match the Next.js port
# (often 3000, or 3001 if 3000 is taken). In production set both to the deployed site URL.
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Public HTTPS URL for the centered logo in emails. Required for Gmail (cannot load localhost).
# Falls back to FRONTEND_URL/logo.png when unset.
EMAIL_LOGO_URL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Admin / ops ---
ADMIN_EMAILS=
ADMIN_CREATE_SECRET=

# --- DigitalOcean Spaces (S3-compatible image uploads) ---
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_PUBLIC_URL=

# --- FedEx Shipping API ---
FEDEX_API_KEY=
FEDEX_API_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_URL=https://apis-sandbox.fedex.com
